DATABASE_URL=postgresql://usuario:senha@host:5432/postgres
API_KEY=sua_chave_api

# Google OAuth (Calendar)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/oauth/google/callback

# Strava OAuth
# STRAVA_CLIENT_SECRET nunca deve ir para o GPT.
# STRAVA_TOKEN_ENCRYPTION_KEY: gerar com `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`
# Em producao usar redirect HTTPS: https://gojohnny.onrender.com/strava/callback
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:8000/strava/callback
STRAVA_SCOPES=read,activity:read
STRAVA_TOKEN_ENCRYPTION_KEY=
STRAVA_SUCCESS_REDIRECT_URL=
