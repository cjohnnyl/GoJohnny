{
  "openapi": "3.1.0",
  "info": {
    "title": "GoJohnny API",
    "description": "Consultoria pessoal de corrida com IA. Schema otimizado para Custom GPT Actions.",
    "version": "2.0.0"
  },
  "servers": [
    {
      "url": "https://gojohnny.onrender.com",
      "description": "Production"
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "paths": {
    "/sessao/iniciar": {
      "post": {
        "operationId": "iniciarSessao",
        "summary": "Iniciar sessão do atleta",
        "description": "Identifica o atleta por apelido e retorna plano ativo, contexto e instrução de continuação.",
        "tags": [
          "Sessão"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "apelido": {
                    "type": "string",
                    "description": "Apelido do atleta (ex: johnny)"
                  }
                },
                "required": [
                  "apelido"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sessão iniciada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessaoIniciarResponse"
                }
              }
            }
          },
          "422": {
            "description": "Erro de validação"
          }
        }
      }
    },
    "/atletas": {
      "post": {
        "operationId": "criarAtleta",
        "summary": "Criar novo atleta",
        "description": "Cria um novo atleta com perfil básico. O apelido é único no sistema.",
        "tags": [
          "Atletas"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AtletaCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Atleta criado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AtletaRead"
                }
              }
            }
          },
          "409": {
            "description": "Apelido já existe"
          },
          "422": {
            "description": "Erro de validação"
          }
        }
      }
    },
    "/atletas/{apelido}": {
      "get": {
        "operationId": "buscarAtleta",
        "summary": "Buscar atleta por apelido",
        "description": "Retorna os dados completos de um atleta.",
        "tags": [
          "Atletas"
        ],
        "parameters": [
          {
            "name": "apelido",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Apelido do atleta"
          }
        ],
        "responses": {
          "200": {
            "description": "Dados do atleta",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AtletaRead"
                }
              }
            }
          },
          "404": {
            "description": "Atleta não encontrado"
          }
        }
      },
      "patch": {
        "operationId": "atualizarAtleta",
        "summary": "Atualizar dados do atleta",
        "description": "Atualiza dados pessoais do atleta (nome, objetivo, nível, etc).",
        "tags": [
          "Atletas"
        ],
        "parameters": [
          {
            "name": "apelido",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Apelido do atleta"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AtletaUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Atleta atualizado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AtletaRead"
                }
              }
            }
          },
          "404": {
            "description": "Atleta não encontrado"
          },
          "422": {
            "description": "Erro de validação"
          }
        }
      }
    },
    "/atletas/{apelido}/flags": {
      "patch": {
        "operationId": "atualizarFlags",
        "summary": "Atualizar feature flags do atleta",
        "description": "Ativa ou desativa funcionalidades: datas reais, contexto atleta, Google Calendar, Strava.",
        "tags": [
          "Atletas"
        ],
        "parameters": [
          {
            "name": "apelido",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Apelido do atleta"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AtletaFlagsUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Flags atualizadas",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AtletaFlags"
                }
              }
            }
          },
          "404": {
            "description": "Atleta não encontrado"
          }
        }
      }
    },
    "/planos-semanais": {
      "post": {
        "operationId": "criarPlano",
        "summary": "Criar plano semanal",
        "description": "Cria um novo plano de treino para um atleta. Se já existe plano ativo, use novo_ciclo=true para arquivar o anterior.",
        "tags": [
          "Planos"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PlanoSemanalCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Plano criado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlanoSemanalRead"
                }
              }
            }
          },
          "409": {
            "description": "Plano ativo já existe. Use novo_ciclo=true para criar novo."
          },
          "422": {
            "description": "Erro de validação"
          }
        }
      }
    },
    "/planos-semanais/{apelido}/atual": {
      "get": {
        "operationId": "buscarPlanoAtual",
        "summary": "Buscar plano ativo do atleta",
        "description": "Retorna o plano semanal ativo (status=ativo) mais recente do atleta.",
        "tags": [
          "Planos"
        ],
        "parameters": [
          {
            "name": "apelido",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Apelido do atleta"
          }
        ],
        "responses": {
          "200": {
            "description": "Plano ativo",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlanoSemanalRead"
                }
              }
            }
          },
          "404": {
            "description": "Atleta não encontrado ou sem plano ativo"
          }
        }
      }
    },
    "/planos-semanais/{apelido}": {
      "get": {
        "operationId": "listarPlanos",
        "summary": "Listar planos do atleta",
        "description": "Retorna todos os planos (ativos e arquivados) do atleta, ordenados por data decrescente.",
        "tags": [
          "Planos"
        ],
        "parameters": [
          {
            "name": "apelido",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Apelido do atleta"
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de planos",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PlanoSemanalRead"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Atleta não encontrado"
          }
        }
      }
    },
    "/checkins": {
      "post": {
        "operationId": "criarCheckin",
        "summary": "Criar check-in de treino",
        "description": "Registra o desempenho de uma semana: treinos realizados, volume, sensação, dores.",
        "tags": [
          "Checkins"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CheckinCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Check-in criado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckinRead"
                }
              }
            }
          },
          "422": {
            "description": "Erro de validação"
          }
        }
      }
    },
    "/checkins/{apelido}": {
      "get": {
        "operationId": "listarCheckins",
        "summary": "Listar check-ins do atleta",
        "description": "Retorna todos os check-ins registrados para um atleta.",
        "tags": [
          "Checkins"
        ],
        "parameters": [
          {
            "name": "apelido",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Apelido do atleta"
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de check-ins",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CheckinRead"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Atleta não encontrado"
          }
        }
      }
    },
    "/calendario/{apelido}/preview": {
      "get": {
        "operationId": "previewCalendario",
        "summary": "Preview do calendário",
        "description": "Retorna preview dos eventos de treino do plano ativo (sem publicar no Google Calendar).",
        "tags": [
          "Calendário"
        ],
        "parameters": [
          {
            "name": "apelido",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Apelido do atleta"
          }
        ],
        "responses": {
          "200": {
            "description": "Preview do calendário",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CalendarioPreview"
                }
              }
            }
          },
          "404": {
            "description": "Atleta não encontrado"
          }
        }
      }
    },
    "/calendario/{apelido}/publicar": {
      "post": {
        "operationId": "publicarCalendario",
        "summary": "Publicar eventos no Google Calendar",
        "description": "Publica os eventos do plano ativo no Google Calendar do atleta. Requer integração prévia.",
        "tags": [
          "Calendário"
        ],
        "parameters": [
          {
            "name": "apelido",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Apelido do atleta"
          }
        ],
        "responses": {
          "200": {
            "description": "Eventos publicados",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CalendarioPublicacaoResponse"
                }
              }
            }
          },
          "404": {
            "description": "Atleta não encontrado ou sem integração com Google"
          }
        }
      }
    },
    "/oauth/google/login/{apelido}": {
      "get": {
        "operationId": "loginGoogle",
        "summary": "Iniciar login com Google",
        "description": "Gera URL para o atleta autenticar com Google e permitir acesso ao Google Calendar.",
        "tags": [
          "OAuth"
        ],
        "parameters": [
          {
            "name": "apelido",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Apelido do atleta"
          }
        ],
        "responses": {
          "200": {
            "description": "URL de autenticação",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OAuthLoginResponse"
                }
              }
            }
          },
          "404": {
            "description": "Atleta não encontrado"
          }
        }
      }
    },
    "/oauth/google/status/{apelido}": {
      "get": {
        "operationId": "statusGoogle",
        "summary": "Verificar status de conexão com Google",
        "description": "Verifica se o atleta está conectado ao Google e se o token ainda é válido.",
        "tags": [
          "OAuth"
        ],
        "parameters": [
          {
            "name": "apelido",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Apelido do atleta"
          }
        ],
        "responses": {
          "200": {
            "description": "Status da conexão",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OAuthStatusResponse"
                }
              }
            }
          },
          "404": {
            "description": "Atleta não encontrado"
          }
        }
      }
    },
    "/memorias/{apelido}": {
      "post": {
        "operationId": "salvarMemoria",
        "summary": "Salvar memória do atleta",
        "description": "Salva memória útil evitando duplicatas",
        "tags": [
          "Memórias"
        ],
        "parameters": [
          {
            "name": "apelido",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Apelido do atleta"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AtletaMemoriaCreate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Memória salva",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string"
                    },
                    "memoria": {
                      "$ref": "#/components/schemas/AtletaMemoriaRead"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Atleta não encontrado"
          }
        }
      }
    },
    "/memorias/{apelido}/resumo": {
      "get": {
        "operationId": "buscarResumoMemorias",
        "summary": "Buscar resumo de memórias",
        "description": "Retorna memórias mais importantes e recentes",
        "tags": [
          "Memórias"
        ],
        "parameters": [
          {
            "name": "apelido",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limite",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 20
            }
          },
          {
            "name": "tipo",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Resumo",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemoriasResumoResponse"
                }
              }
            }
          },
          "404": {
            "description": "Atleta não encontrado"
          }
        }
      }
    },
    "/memorias/{apelido}/buscar": {
      "get": {
        "operationId": "buscarMemorias",
        "summary": "Buscar memórias por texto",
        "description": "Busca memórias relevantes por texto",
        "tags": [
          "Memórias"
        ],
        "parameters": [
          {
            "name": "apelido",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limite",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Resultados",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BuscaMemorias"
                }
              }
            }
          },
          "404": {
            "description": "Atleta não encontrado"
          }
        }
      }
    },
    "/memorias/{apelido}/resumo-semanal": {
      "post": {
        "operationId": "salvarResumoSemanal",
        "summary": "Salvar resumo semanal",
        "description": "Registra resumo fechado da semana",
        "tags": [
          "Memórias"
        ],
        "parameters": [
          {
            "name": "apelido",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResumoSemanalCreate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Salvo",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string"
                    },
                    "memoria": {
                      "$ref": "#/components/schemas/AtletaMemoriaRead"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Atleta não encontrado"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key",
        "description": "API Key para autenticação (fornecida pelo GoJohnny)"
      }
    },
    "schemas": {
      "SessaoIniciarResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "novo",
              "existente"
            ],
            "description": "novo = atleta não encontrado, existente = atleta já registrado"
          },
          "atleta": {
            "$ref": "#/components/schemas/AtletaRead"
          },
          "plano_atual": {
            "$ref": "#/components/schemas/PlanoSemanalRead"
          },
          "contexto_resumo": {
            "type": "object",
            "description": "Contexto histórico do atleta (objetivo, treino, preferências)"
          },
          "flags": {
            "$ref": "#/components/schemas/AtletaFlags"
          },
          "instrucao_continuacao": {
            "type": "string",
            "description": "Instrução para o GPT continuar a conversa"
          }
        },
        "required": [
          "status",
          "flags",
          "instrucao_continuacao"
        ]
      },
      "AtletaCreate": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string",
            "description": "Nome completo do atleta"
          },
          "apelido": {
            "type": "string",
            "description": "Apelido único do atleta (ex: johnny, pedro, maria)"
          },
          "objetivo": {
            "type": "string",
            "description": "Objetivo principal de treino"
          },
          "nivel": {
            "type": "string",
            "enum": [
              "iniciante",
              "intermediario",
              "avancado"
            ],
            "description": "Nível de experiência em corrida"
          },
          "dias_treino": {
            "type": "integer",
            "description": "Quantos dias por semana o atleta pode treinar"
          },
          "altura_cm": {
            "type": "integer",
            "description": "Altura em centímetros"
          },
          "peso_kg": {
            "type": "number",
            "description": "Peso em kilogramas"
          },
          "pace_confortavel": {
            "type": "string",
            "description": "Ritmo confortável (ex: 6:00/km)"
          },
          "maior_distancia_recente_km": {
            "type": "number",
            "description": "Maior distância já corrida"
          },
          "historico_dores": {
            "type": "string",
            "description": "Histórico de lesões ou dores"
          }
        },
        "required": [
          "nome",
          "apelido"
        ]
      },
      "AtletaRead": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "ID único do atleta"
          },
          "nome": {
            "type": "string"
          },
          "apelido": {
            "type": "string"
          },
          "objetivo": {
            "type": "string"
          },
          "nivel": {
            "type": "string"
          },
          "dias_treino": {
            "type": "integer"
          },
          "altura_cm": {
            "type": "integer"
          },
          "peso_kg": {
            "type": "number"
          },
          "pace_confortavel": {
            "type": "string"
          },
          "maior_distancia_recente_km": {
            "type": "number"
          },
          "historico_dores": {
            "type": "string"
          },
          "usar_datas_reais": {
            "type": "boolean",
            "description": "Se true, usa datas reais ao invés de simuladas"
          },
          "usar_contexto_atleta": {
            "type": "boolean",
            "description": "Se true, inclui contexto do atleta na geração de planos"
          },
          "usar_google_calendar": {
            "type": "boolean",
            "description": "Se true, integra com Google Calendar"
          },
          "usar_strava": {
            "type": "boolean",
            "description": "Se true, integra com Strava"
          },
          "criado_em": {
            "type": "string",
            "format": "date-time"
          },
          "atualizado_em": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id"
        ]
      },
      "AtletaUpdate": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string"
          },
          "objetivo": {
            "type": "string"
          },
          "nivel": {
            "type": "string"
          },
          "dias_treino": {
            "type": "integer"
          },
          "altura_cm": {
            "type": "integer"
          },
          "peso_kg": {
            "type": "number"
          },
          "pace_confortavel": {
            "type": "string"
          },
          "maior_distancia_recente_km": {
            "type": "number"
          },
          "historico_dores": {
